// LD405 405 nm laser diode pulse driver - 3D printed enclosure.
// Generated by tools/gen_enclosure.py (board data) - the geometry below may be
// tweaked by hand; rerun the generator only if the board placement changes.
//
// Coordinates: X = board x - 100, Y = 200 - board y (front panel inner face at
// Y = 100, rear panel inner face at Y = 0), Z up from the underside of the base.
//
// Parts: base (floor, side walls, PCB standoffs, lid posts), front panel, rear
// panel, lid.  The panels drop into grooves in the base and are held by the lid.
// Hardware: 4x M3x12 pan head + 4x M3 nut (PCB), 4x M3x10 countersunk + 4x M3
// nut (lid), 4x adhesive rubber feet <= 10 mm.
//
// render one part:  openscad -D 'part="base"' -o base.stl ld405_enclosure.scad

part = "assembly";   // assembly | base | lid | front | rear | print_front | print_rear | print_lid
$fn = 64;

// ---------------------------------------------------------------- board data
// generated from tools/placement.py - do not edit here
pcb_w = 160;  pcb_d = 100;  pcb_t = 1.6;
mount_holes = [[4.5, 85.5], [155.5, 83.5], [4.5, 4.5], [138, 54]];
bnc = [[108, "TTL IN"], [128, "I MON"], [148, "SET MON"]];           // [X, label]
pots = [[60, "PULSE"], [84, "IDLE"]];
toggles = [[40, "ENABLE"]];
leds = [[6, "POWER"], [13, "ARMED"], [20, "EMISSION"], [27, "FAULT"]];
dsub = [40, "LD OUT"];
jack35 = [128, "INTERLOCK"];
dcjack = [147, "9V DC"];
h_bnc = 9.8; h_pot = 6.5; h_toggle = 6.46; h_led = 0.75;
h_dsub = 6.25; h_jack35 = 2.5; h_dcjack = 6.5;


// ---------------------------------------------------------------- geometry
wall = 2.5;  floor_t = 3.0;  lid_t = 2.5;  panel_t = 2.5;
so_h = 6.0;                         // PCB standoff height (THT leads need ~2.5 mm)
z_pcb = floor_t + so_h + pcb_t;     // top face of the PCB
z_top = z_pcb + 19.0;               // underside of the lid (tallest part ~17 mm)
H = z_top + lid_t;
xi0 = -8;  xi1 = pcb_w + 8;         // inner faces of the side walls
xo0 = xi0 - wall;  xo1 = xi1 + wall;
yf = pcb_d;  yr = 0;                // panel inner faces = PCB front/rear edges
lip = 1.5;                          // walls stand proud of the panels
yo0 = yr - panel_t - lip;  yo1 = yf + panel_t + lip;
g_side = 1.2;  g_floor = 1.5;  g_lid = 1.2;  clr = 0.2;
posts = [[-4, 8], [-4, pcb_d - 8], [pcb_w + 4, 8], [pcb_w + 4, pcb_d - 8]];
post_d = 7.5;
engrave = 0.6;
font = "Liberation Sans:style=Bold";

// ---------------------------------------------------------------- helpers
module yhole(x, z, d) { translate([x, -50, z]) rotate([-90, 0, 0]) cylinder(d = d, h = 300); }
module yslot(x, z, w, h, y0, y1) { translate([x - w / 2, y0, z - h / 2]) cube([w, y1 - y0, h]); }
module rrect(w, h, r) { offset(r) square([w - 2 * r, h - 2 * r], center = true); }
module dshape(wt, wb, h, r) {       // D-sub cutout, wide side up
    offset(r) polygon([[-wb / 2 + r, -h / 2 + r], [wb / 2 - r, -h / 2 + r],
                       [wt / 2 - r, h / 2 - r], [-wt / 2 + r, h / 2 - r]]);
}
module front_text(s, x, z, size, ang = 0) {      // engraved, reads from the front
    translate([x, yf + panel_t - engrave, z]) rotate([90, 0, 180]) rotate([0, 0, ang])
        linear_extrude(engrave + 1)
            text(s, size = size, font = font, halign = "center", valign = "center");
}
module rear_text(s, x, z, size, ang = 0) {       // engraved, reads from the rear
    translate([x, yr - panel_t + engrave, z]) rotate([90, 0, 0]) rotate([0, 0, ang])
        linear_extrude(engrave + 1)
            text(s, size = size, font = font, halign = "center", valign = "center");
}
module panel_blank(y0) {
    translate([xi0 - g_side + clr, y0, floor_t - g_floor + clr])
        cube([xi1 - xi0 + 2 * (g_side - clr), panel_t, z_top + g_lid - floor_t + g_floor - 2 * clr]);
}

// ---------------------------------------------------------------- front panel
module front_panel() {
    difference() {
        panel_blank(yf);
        for (b = bnc) {                                   // M12x0.75 bulkhead BNC
            yhole(b[0], z_pcb + h_bnc, 12.4);
            front_text(b[1], b[0], z_pcb + h_bnc - 10.2, 3.0);
        }
        for (p = pots) {                                  // M9x0.75 bushing, 6 mm shaft
            yhole(p[0], z_pcb + h_pot, 9.5);
            // spot face: leaves 2.0 mm for washer + nut on the 5 mm bushing
            translate([p[0], yf + panel_t - 0.5, z_pcb + h_pot]) rotate([-90, 0, 0]) cylinder(d = 17, h = 2);
            // anti-rotation lug (2 x 0.8 mm, 6 mm below the shaft) - pocket on the inside
            yslot(p[0], z_pcb + h_pot - 6.0, 2.8, 1.8, yf - 1, yf + 1.2);
            front_text(p[1], p[0], z_pcb + h_pot + 10.5, 3.0);
            // clockwise (towards terminal 3) raises the setting
            front_text("0", p[0] + 7.0, z_pcb + h_pot - 7.6, 1.8);
            front_text("MAX", p[0] - 8.5, z_pcb + h_pot - 7.6, 1.8);
        }
        for (t = toggles) {                               // unthreaded 1/4" bushing
            yhole(t[0], z_pcb + h_toggle, 6.8);
            front_text(t[1], t[0], z_pcb + h_toggle + 7.5, 3.0);
        }
        for (l = leds) {                                  // side-view LED windows
            yslot(l[0], z_pcb + h_led + 0.15, 3.2, 1.9, yf - 1, yf + panel_t + 1);
            front_text(l[1], l[0], z_pcb + h_led + 9.5, 2.3, -90);
        }
    }
}

// ---------------------------------------------------------------- rear panel
module rear_panel() {
    zd = z_pcb + h_dsub;  zj = z_pcb + h_jack35;  zdc = z_pcb + h_dcjack;
    difference() {
        panel_blank(yr - panel_t);
        // DE-9 (CONNFLY DS1037, "7.2 mm" type): the 31 x 12.5 mm steel flange stands
        // 0.4 mm proud of the board edge -> 0.6 mm recess on the inside; the 4-40 hex
        // jack posts (5 mm A/F, 4.8 mm tall) pass through; outside pocket leaves 1.1 mm
        // so the cable plug mates fully.
        translate([dsub[0], 0, zd]) rotate([90, 0, 0]) linear_extrude(10, center = true) dshape(20.2, 17.6, 11.4, 1.6);
        for (s = [-12.5, 12.5]) yhole(dsub[0] + s, zd, 6.3);
        translate([dsub[0] - 16.2, yr - 0.6, z_pcb - 0.6]) cube([32.4, 1, 13.8]);
        translate([dsub[0] - 17.5, yr - panel_t - 1, zd - 8]) cube([35, 1 + 0.8, 16]);
        rear_text(dsub[1], dsub[0], zd + 10.6, 3.2);
        rear_text("8 = LD anode   3 = LD cathode   1-5 = interlock loop", dsub[0], zd - 10.3, 2.0);
        // 3.5 mm interlock jack: plug body must reach the jack face
        yhole(jack35[0], zj, 8.6);
        translate([jack35[0], yr - panel_t - 1, zj]) rotate([-90, 0, 0]) cylinder(d = 12, h = 1 + 1.2);
        rear_text(jack35[1], jack35[0], zj + 12.5, 2.5);
        rear_text("short = OK", jack35[0], zj + 8.6, 2.0);
        // DC jack (5.5 / 2.1 mm plug, centre +)
        yhole(dcjack[0], zdc, 11.0);
        rear_text("9V DC", dcjack[0], zdc + 9.6, 3.0);
        rear_text("centre +  2A", dcjack[0], z_pcb - 4.6, 2.0);
    }
}

// ---------------------------------------------------------------- base
module base() {
    difference() {
        union() {
            translate([xo0, yo0, 0]) cube([xo1 - xo0, yo1 - yo0, floor_t]);
            for (x = [xo0, xi1]) translate([x, yo0, 0]) cube([wall, yo1 - yo0, z_top]);
            for (h = mount_holes) translate([h[0], h[1], 0]) cylinder(d = 7, h = floor_t + so_h);
            for (p = posts) {
                translate([p[0], p[1], 0]) cylinder(d = post_d, h = z_top);
                // web to the side wall
                translate([p[0] < 0 ? xi0 - 0.01 : p[0], p[1] - post_d / 2, 0])
                    cube([abs(p[0] - (p[0] < 0 ? xi0 : xi1)) + 0.01, post_d, z_top]);
            }
        }
        // panel grooves (floor + both side walls)
        for (y0 = [yf - clr, yr - panel_t - clr])
            translate([xi0 - g_side, y0, floor_t - g_floor]) cube([xi1 - xi0 + 2 * g_side, panel_t + 2 * clr, z_top]);
        // PCB screws from below: M3 through hole + counterbore for the pan head
        for (h = mount_holes) {
            translate([h[0], h[1], -1]) cylinder(d = 3.4, h = 50);
            translate([h[0], h[1], -1]) cylinder(d = 6.6, h = 1 + 2.0);
        }
        // lid posts: M3 hole + side-entry nut slot (open towards the PCB)
        for (p = posts) {
            translate([p[0], p[1], z_top - 12]) cylinder(d = 3.4, h = 13);
            translate([p[0], p[1], z_top - 6.0]) rotate([0, 0, p[0] < 0 ? 0 : 180])
                translate([-3.2, -3.0, 0]) cube([10, 6.0, 2.9]);
        }
        // ventilation slots in the floor (under the logic / analogue area)
        for (i = [0:7]) translate([30 + i * 12, 30, -1]) cube([2.5, 40, floor_t + 2]);
        // rubber feet recesses
        for (x = [xo0 + 9, xo1 - 9], y = [yo0 + 9, yo1 - 9]) translate([x, y, -0.01]) cylinder(d = 10.5, h = 0.8);
        // engraved label underneath
        translate([pcb_w / 2, yo1 - 16, -0.01]) mirror([1, 0, 0]) linear_extrude(engrave)
            text("LD405 driver - lid: 4x M3x10 csk, PCB: 4x M3x12 + nuts", size = 3, font = font, halign = "center");
    }
}

// ---------------------------------------------------------------- lid
module laser_sign(s) {          // ISO 7010 W004 style laser warning triangle
    difference() {
        offset(r = s * 0.06) polygon([[-s / 2, -s * 0.29], [s / 2, -s * 0.29], [0, s * 0.577]]);
        offset(r = -s * 0.02) polygon([[-s / 2, -s * 0.29], [s / 2, -s * 0.29], [0, s * 0.577]]);
    }
    translate([-s * 0.05, -s * 0.03]) circle(d = s * 0.14);
    for (a = [0:30:330]) if (a != 0) translate([-s * 0.05, -s * 0.03]) rotate(a)
        translate([s * 0.09, -s * 0.012]) square([a == 180 ? 0 : s * 0.1, s * 0.024]);
    translate([-s * 0.05, -s * 0.042]) square([s * 0.33, s * 0.024]);
}
module lid() {
    difference() {
        translate([xo0, yo0, z_top]) cube([xo1 - xo0, yo1 - yo0, lid_t]);
        for (y0 = [yf - clr, yr - panel_t - clr])
            translate([xi0 - g_side, y0, z_top - 1]) cube([xi1 - xi0 + 2 * g_side, panel_t + 2 * clr, 1 + g_lid]);
        for (p = posts) {
            translate([p[0], p[1], z_top - 1]) cylinder(d = 3.4, h = 10);
            translate([p[0], p[1], H - 1.7]) cylinder(d1 = 3.4, d2 = 6.8, h = 1.71);
        }
        // vents above the regulator and the pass transistor
        for (i = [0:5]) translate([128 + i * 4.5, 36, z_top - 1]) cube([2.2, 22, lid_t + 2]);
        for (i = [0:4]) translate([80 + i * 4.5, 16, z_top - 1]) cube([2.2, 16, lid_t + 2]);
        // markings (read from the front)
        translate([40, 66, H - engrave]) rotate([0, 0, 180]) linear_extrude(1) laser_sign(26);
        translate([pcb_w / 2 + 10, 84, H - engrave]) rotate([0, 0, 180]) linear_extrude(1)
            text("405 nm LASER DIODE PULSE DRIVER", size = 5, font = font, halign = "center");
        translate([pcb_w / 2 + 10, 74, H - engrave]) rotate([0, 0, 180]) linear_extrude(1)
            text("CLASS 4 LASER - AVOID EYE OR SKIN EXPOSURE", size = 3.6, font = font, halign = "center");
        translate([pcb_w / 2 + 10, 67, H - engrave]) rotate([0, 0, 180]) linear_extrude(1)
            text("to direct or scattered radiation", size = 3.2, font = font, halign = "center");
    }
}

// ---------------------------------------------------------------- preview only
module pcb_dummy() {
    color("darkgreen") difference() {
        translate([0, 0, z_pcb - pcb_t]) cube([pcb_w, pcb_d, pcb_t]);
        for (h = mount_holes) translate([h[0], h[1], 0]) cylinder(d = 3.2, h = 50);
    }
    color("silver") {
        // BNC: centre contact 6 mm behind the panel face, Ø14 flange against it
        for (b = bnc) translate([b[0], yf - 6, z_pcb + h_bnc]) rotate([-90, 0, 0]) {
            translate([-5, -5, -5]) cube([10, 5 + h_bnc, 10]);
            translate([0, 0, 5]) cylinder(d = 14, h = 1);
            cylinder(d = 12, h = 14); cylinder(d = 9.6, h = 24.5);
        }
        for (p = pots) translate([p[0], yf - 7.45, z_pcb + h_pot]) rotate([-90, 0, 0]) {
            translate([-6, -5.5, 0]) cube([12.1, 12, 7.45]);
            cylinder(d = 9, h = 12.45); cylinder(d = 6, h = 22.45);
        }
        for (t = toggles) translate([t[0], yf - 2, z_pcb + h_toggle]) rotate([-90, 0, 0]) {
            translate([-3.5, -6, -21]) cube([7, 12, 21]); cylinder(d = 6.2, h = 7.1);
            translate([0, 0, 7.1]) cylinder(d1 = 3, d2 = 2.4, h = 11);
        }
    }
    color("dimgray") {
        translate([dsub[0] - 15.5, 0, z_pcb]) cube([31, 10.5, 12.5]);
        translate([dsub[0], 0.01, z_pcb + h_dsub]) rotate([90, 0, 0]) linear_extrude(6.4) dshape(16.9, 14.4, 8.0, 1);
        translate([jack35[0] - 3.05, 0, z_pcb]) cube([6.1, 12.1, 5]);
        translate([dcjack[0] - 4.5, 0, z_pcb]) cube([9, 14, 11]);
        translate([84, 22, z_pcb]) cube([10, 10, 2.5]);
    }
    color("lightgray") for (p = [[132.5, 19.5], [132.5, 30.5]]) translate([p[0], p[1], z_pcb]) cylinder(d = 8, h = 10.5);
}

module assembly() {
    color("#3a3a3a") base();
    color("#2a5d8f") front_panel();
    color("#2a5d8f") rear_panel();
    pcb_dummy();
    color("#3a3a3a", 0.35) translate([0, 0, 25]) lid();
}

if (part == "assembly") assembly();
else if (part == "base") base();
else if (part == "lid") lid();
else if (part == "front") front_panel();
else if (part == "rear") rear_panel();
// print orientations: panels inner face down, lid top down
else if (part == "print_front") translate([0, 0, -yf]) rotate([90, 0, 0]) front_panel();
else if (part == "print_rear") rotate([-90, 0, 0]) rear_panel();
else if (part == "print_lid") translate([0, 0, H]) rotate([180, 0, 0]) lid();
